#include <iostream>
#include <unordered_map>

#include "llvm/Analysis/CallGraph.h"
#include "llvm/Passes/PassBuilder.h"
#include "llvm/Passes/PassPlugin.h"
#include "llvm/Support/raw_ostream.h"
#include "llvm/Transforms/IPO/PassManagerBuilder.h"
#include "llvm/Transforms/Utils/Cloning.h"

using namespace llvm;

namespace {
const unsigned CACHE_SIZE = 16;

inline unsigned getCycleCount(Instruction &I) {
  // Hack the cost model.
  if (BinaryOperator *BO = dyn_cast<BinaryOperator>(&I)) {
      switch(BO->getOpcode()) {
      case BinaryOperator::BinaryOps::Mul: return 5;
      case BinaryOperator::BinaryOps::Sub: return 4;
      case BinaryOperator::BinaryOps::Add: return 4;
      case BinaryOperator::BinaryOps::Shl: return 4;
      case BinaryOperator::BinaryOps::AShr: return 4;
      case BinaryOperator::BinaryOps::LShr: return 4;
      case BinaryOperator::BinaryOps::And: return 4;
      case BinaryOperator::BinaryOps::Or: return 4;
      case BinaryOperator::BinaryOps::Xor: return 4;
      // Make division stuff expensive like on a real processor.
      case BinaryOperator::BinaryOps::SDiv: return 9;
      case BinaryOperator::BinaryOps::UDiv: return 9;
      case BinaryOperator::BinaryOps::SRem: return 9;
      case BinaryOperator::BinaryOps::URem: return 9;
      default:
          break; // Not supported.
      }
  }

  if (isa<GetElementPtrInst>(I)) return 4;
  if (isa<CmpInst>(I)) return 5;

  if (isa<SExtInst>(I)) return 1;
  if (isa<ZExtInst>(I)) return 1;
  if (isa<TruncInst>(I)) return 1;

  // Casts are free.
  if (isa<BitCastInst>(I)) return 0;
  if (isa<PtrToIntInst>(I)) return 0;

  // We make calls cheap, as the real cost is that they flush the icache
  // when they jump to a new instruction.
  // For simplicity, we keep external library functions cheap.
  if (CallInst *Call = dyn_cast<CallInst>(&I))
      return 1U + Call->getNumOperands();

  // Memory ops.
  if (isa<AllocaInst>(I)) return 2;
  if (isa<LoadInst>(I)) return 4;
  if (isa<StoreInst>(I)) return 4;

  // Control flow stuff.
  if (isa<BranchInst>(I)) return 10;
  if (isa<SwitchInst>(I)) return 10;
  if (isa<ReturnInst>(I)) return 7;
  if (isa<SelectInst>(I)) return 15;

  // Vector stuff.
  if (isa<ExtractValueInst>(I)) return 7;
  if (isa<InsertValueInst>(I)) return 7;

  if (isa<FreezeInst>(I)) return 0;

  // Assume that PHI nodes are not actually lowered to real instructions.
  if (isa<PHINode>(I)) return 0;
  if (isa<UnreachableInst>(I)) return 0;
  return 0;
}

struct CocoInlinerPass : PassInfoMixin<CocoInlinerPass> {
  bool tryInline(Function &f, CallInst &call) {
    ;
    InlineFunctionInfo info;
    auto InlineRes = InlineFunction(call, info);
    assert(InlineRes.isSuccess() && "Expected inlining to succeed");
    return true;
  }

  PreservedAnalyses run(Module &M, ModuleAnalysisManager &) {
    CallGraph cg(M);
    std::unordered_map<const char *, unsigned long> FunctionSizes;

    // Get the total instruction count of the function
    for (auto &f : M.functions()) {
      long unsigned Cost = 0;

      for (auto &B : f.getBasicBlockList()) {
        for (auto &I : B) {
          if (auto inst = dyn_cast<Instruction>(&I)) {
            Cost += getCycleCount(*inst);
          }
        }
      }

      fprintf(stderr, "Function %s: instructions %ld\n",
               f.getName().data(), Cost);
      FunctionSizes[f.getName().data()] = Cost;
    }

    // Loop through the call graph.
    for (auto &funcAndNode : cg) {
      // Function that we originate from
      Function *f = const_cast<Function *>(funcAndNode.first);

      // I don't actually know what this is actually
      std::unique_ptr<CallGraphNode> &CGN = funcAndNode.second;

      // Ensure that neither both are mapped to value. These are
      // dynamically casted, so they can be null.
      if (!f || !CGN->getFunction()) continue;

      // Store all the calls in the function in a list so we can
      // delete at the end. Doing it earlier causes a panic.
      std::vector<CallInst *> calls;
      for (auto &Instr : instructions(f)) {
        auto *ci = dyn_cast<CallInst>(&Instr);
        if (!ci) continue;

        const Function *CalledFunction = ci->getCalledFunction();
        if (!CalledFunction) continue;

        if (CalledFunction->isDeclaration()) {
          continue;
        }

        calls.push_back(ci);
      }

      for (auto &ci : calls) {
        const char *FuncName = ci->getName().data();
        // Use the cost model to try if we need to inline it.
        errs() << "cost model: " << FunctionSizes[FuncName] << " cycle this call: " << *ci << "\n";

        if (FunctionSizes[FuncName] < getCycleCount(*ci) * 5) continue;

        tryInline(*f, *ci);
      }

      break;
    }
    return PreservedAnalyses::all();
  }
};
}  // namespace

// This is just boilerplate to register the pass.
// Do do not need to modify this code.
extern "C" LLVM_ATTRIBUTE_WEAK llvm::PassPluginLibraryInfo
llvmGetPassPluginInfo() {
  return {LLVM_PLUGIN_API_VERSION, "CocoInliner", LLVM_VERSION_STRING,
          [](PassBuilder &PB) {
            PB.registerPipelineParsingCallback(
                [](StringRef Name, ModulePassManager &PM,
                   ArrayRef<PassBuilder::PipelineElement>) {
                  if (Name == "coco-inliner") {
                    PM.addPass(CocoInlinerPass());
                    return true;
                  }
                  return false;
                });
          }};
}
